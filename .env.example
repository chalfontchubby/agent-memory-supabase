# Copy to .env (git-ignored) and fill in. scripts/setup.ts adds the AGENT_MEMORY_* keys itself.

# Supabase personal access token: dashboard > Account > Access Tokens. Starts with sbp_.
SUPABASE_ACCESS_TOKEN=sbp_replace_me

# The database password you chose when creating the project (reset it under Settings > Database if lost).
SUPABASE_DB_PASSWORD=replace-me

# The project reference: the id in the dashboard URL (https://supabase.com/dashboard/project/<ref>) or Settings > General.
SUPABASE_PROJECT_REF=replace-me
